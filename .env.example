# Example for a same-host HTTPS tunnel to the loopback Node service.
# Node does not load this file automatically. Export it before npm start.
HOST=127.0.0.1
PORT=3001
CATAN_DATA_DIR=data
CATAN_PUBLIC_URL=https://catan.rlin.dev
CATAN_SITE_NAME='Catan Online by rlin'
CATAN_MAX_ROOMS=16

# Replace with a publicly fetchable tag or commit matching the deployed server.
# Pin the deployed revision so future main changes do not alter client setup.
CATAN_BRIDGE_REF=REPLACE_WITH_PUBLISHED_REF

# Optional: only when a same-host tunnel is the sole route to the origin.
# For a separate proxy, use its exact IP/CIDR after verifying the network path.
# CATAN_TRUST_PROXY=loopback

# Optional private operator override. Omit to generate data/host-key on first start.
# CATAN_HOST_KEY=at-least-16-private-characters
